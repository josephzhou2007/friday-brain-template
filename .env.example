# Copy to .env (gitignored) and fill in. Never commit the real file.

# One Telegram bot per agent: create each with @BotFather, paste its token here.
TELEGRAM_TOKEN_FRIDAY=
TELEGRAM_TOKEN_STUDY=
TELEGRAM_TOKEN_FEED=
TELEGRAM_TOKEN_DEV=
TELEGRAM_TOKEN_TRADER=

# Optional: agents/trader/scripts/stock.py (free key at https://finnhub.io)
FINNHUB_API_KEY=

# Claude itself needs no key here: the relay runs the `claude` CLI, which uses
# whatever you logged in with (`claude` -> /login). A subscription login is
# billed to the subscription; ANTHROPIC_API_KEY in the environment is billed per token.
